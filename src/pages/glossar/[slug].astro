---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import ArticleListing from "../../components/ArticleListing.astro";
import TagListing from "../../components/TagListing.astro";
import { getArticlesByIds } from "../../lib/articles";
import {
	getGlossarEntries,
	getGlossarHref,
	getGlossarRelatedTags,
} from "../../lib/glossar";

export async function getStaticPaths() {
	const entries = await getGlossarEntries();
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const relatedArticleIds = entry.data.relatedArticles ?? [];
const related = await getArticlesByIds(relatedArticleIds);
const relatedTags = await getGlossarRelatedTags(entry);
const relatedTagIds = relatedTags.map(({ tag }) => tag.id);
---

<BaseLayout
	title={entry.data.title}
	description={entry.data.definition}
	modifiedDate={entry.data.modifiedDate}
>
	<main class="page">
		<p class="text-sm text-muted"><a href="/glossar/">Glossar</a></p>
		<article>
			<PageHero title={entry.data.title} description={entry.data.definition} />
			<Content />
			{
				(related.length > 0 || relatedTags.length > 0) && (
					<div class="glossar-related">
						{relatedTags.length > 0 && (
							<section class="glossar-related__block">
								<h2>Verwandte Tags</h2>
								<TagListing
									layout="list"
									tagIds={relatedTagIds}
									usedOnly={true}
									compact={true}
									gap={1}
								/>
							</section>
						)}
						{related.length > 0 && (
							<section class="glossar-related__block">
								<h2>Verwandte Artikel</h2>
								<ArticleListing
									articleIds={relatedArticleIds}
									layout="grid"
									columns={1}
									gap={3}
									compact={true}
								/>
							</section>
						)}
					</div>
				)
			}
		</article>
		<p class="text-sm">
			<a href="/glossar/">← Alle Begriffe</a>
			{" · "}
			<a href={getGlossarHref(entry)} aria-current="page">Permalink</a>
		</p>
	</main>
</BaseLayout>

<style>
	.glossar-related {
		margin-top: 2rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--color-border);
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.glossar-related__block h2 {
		font-size: 1.125rem;
		margin-top: 0;
		margin-bottom: 1rem;
	}
</style>
