---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import {
	getArticleHref,
	getPublishedArticles,
	isArticlePublic,
} from "../../lib/articles";
import { getGlossarEntries, getGlossarHref } from "../../lib/glossar";

export async function getStaticPaths() {
	const entries = await getGlossarEntries();
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const articles = await getPublishedArticles();
const articleMap = new Map(articles.map((article) => [article.id, article]));
const related = (entry.data.relatedArticles ?? [])
	.map((id) => articleMap.get(id))
	.filter((article): article is (typeof articles)[number] => Boolean(article))
	.filter(isArticlePublic);
---

<BaseLayout
	title={entry.data.title}
	description={entry.data.definition}
	modifiedDate={entry.data.modifiedDate}
>
	<main class="page">
		<p class="text-sm text-muted"><a href="/glossar/">Glossar</a></p>
		<article>
			<PageHero title={entry.data.title} description={entry.data.definition} />
			<Content />
			{
				related.length > 0 && (
					<section class="glossar-related">
						<h2>Verwandte Artikel</h2>
						<ul class="list-plain">
							{related.map((article) => (
								<li>
									<a href={getArticleHref(article)}>{article.data.title}</a>
								</li>
							))}
						</ul>
					</section>
				)
			}
		</article>
		<p class="text-sm">
			<a href="/glossar/">← Alle Begriffe</a>
			{" · "}
			<a href={getGlossarHref(entry)} aria-current="page">Permalink</a>
		</p>
	</main>
</BaseLayout>

<style>
	.glossar-related {
		margin-top: 2rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--color-border);
	}

	.glossar-related h2 {
		font-size: 1.125rem;
		margin-top: 0;
	}
</style>
