---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getGlossarEntries, getGlossarHref } from "../../lib/glossar";

const entries = await getGlossarEntries();
---

<BaseLayout
	title="Glossar"
	description="Kurze Erklärungen zu Fachbegriffen rund um hautuu."
>
	<main class="page">
		<h1>Glossar</h1>
		<p class="text-muted">
			Fachbegriffe kurz erklärt — für Einsteiger in GitHub, Cloudflare, Astro und Co.
		</p>
		{
			entries.length === 0 ? (
				<p>Noch keine Einträge.</p>
			) : (
				<dl class="glossar-list">
					{entries.map((entry) => (
						<div class="glossar-list__item">
							<dt>
								<a href={getGlossarHref(entry)}>{entry.data.title}</a>
							</dt>
							<dd class="text-muted">{entry.data.definition}</dd>
						</div>
					))}
				</dl>
			)
		}
	</main>
</BaseLayout>

<style>
	.glossar-list {
		margin: 1.5rem 0 0;
		padding: 0;
	}

	.glossar-list__item {
		margin: 0 0 1.25rem;
	}

	.glossar-list__item dt {
		font-weight: var(--font-weight-heading);
	}

	.glossar-list__item dd {
		margin: 0.25rem 0 0;
	}
</style>
