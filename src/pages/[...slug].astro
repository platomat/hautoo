---
import { render } from "astro:content";
import BackgroundAttributions from "../components/BackgroundAttributions.astro";
import CmsContent from "../components/CmsContent.astro";
import PageHero from "../components/PageHero.astro";
import TagSidebar from "../components/TagSidebar.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
	contentNeedsWideLayout,
	hasContentEmbeds,
} from "../lib/content-embeds";
import { resolveCmsImage } from "../lib/cms-image";
import { getPageHref, getPublicPages, indexPagesById } from "../lib/pages";
import { resolveTocForCollection } from "../lib/site-config";

export async function getStaticPaths() {
	const pages = await getPublicPages();
	const pagesById = indexPagesById(pages);

	return pages
		.filter((page) => getPageHref(page, pagesById) !== "/")
		.map((page) => {
			const href = getPageHref(page, pagesById);
			const slug = href.replace(/^\/|\/$/g, "");
			return {
				params: { slug },
				props: { page },
			};
		});
}

const { page } = Astro.props;
const useEmbeds = hasContentEmbeds(page.body);
const { Content } = await render(page);
const backgroundImage = resolveCmsImage(
	page.data.backgroundImage,
	`content/pages/${page.id}/`,
);
/** Hardwired system pages (same idea as Impressum attributions). */
const showBackgroundAttributions = page.id === "impressum";
/** Artikel overview keeps Tag-Sidebar; listing comes from CMS embed. */
const showArticleSidebar = page.id === "artikel";
const wide =
	showArticleSidebar || (await contentNeedsWideLayout(page.body));
const toc = await resolveTocForCollection("pages", page.data);
/** Dynamic import: avoid shipping TOC CSS on pages that do not show a TOC. */
const TableOfContents = toc.show
	? (await import("../components/TableOfContents.astro")).default
	: null;
---

<BaseLayout
	title={page.data.title}
	description={page.data.description}
	seo={page.data.seo}
	modifiedDate={page.data.modifiedDate}
	backgroundImage={backgroundImage}
	backgroundOverlay={page.data.backgroundOverlay}
	headCode={page.data.headCode}
	footerCode={page.data.footerCode}
>
	<main
		class:list={[
			"page",
			{ "page--with-sidebar": showArticleSidebar, "page--wide": wide && !showArticleSidebar },
		]}
	>
		{
			showArticleSidebar ? (
				<div class="page-layout flex-row gap-lg stack-on-tablet">
					<div class="page-layout__main min-w-0 w-full">
						<article>
							<PageHero
								title={page.data.title}
								description={page.data.description}
							/>
							{TableOfContents && (
								<TableOfContents
									body={page.body}
									levels={toc.levels}
									title={toc.title}
								/>
							)}
							{useEmbeds ? <CmsContent body={page.body} /> : <Content />}
						</article>
					</div>
					<TagSidebar />
				</div>
			) : (
				<article>
					<PageHero
						title={page.data.title}
						description={page.data.description}
					/>
					{TableOfContents && (
						<TableOfContents
							body={page.body}
							levels={toc.levels}
							title={toc.title}
						/>
					)}
					{useEmbeds ? <CmsContent body={page.body} /> : <Content />}
					{showBackgroundAttributions && <BackgroundAttributions />}
				</article>
			)
		}
	</main>
</BaseLayout>
