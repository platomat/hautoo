---
import { render } from "astro:content";
import ArticleIndexList from "../components/ArticleIndexList.astro";
import BackgroundAttributions from "../components/BackgroundAttributions.astro";
import CmsContent from "../components/CmsContent.astro";
import PageHero from "../components/PageHero.astro";
import TagSidebar from "../components/TagSidebar.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
	hasArticleListingEmbed,
	hasContentEmbeds,
} from "../lib/content-embeds";
import { resolveCmsImage } from "../lib/cms-image";
import { getPageHref, getPublicPages, indexPagesById } from "../lib/pages";

export async function getStaticPaths() {
	const pages = await getPublicPages();
	const pagesById = indexPagesById(pages);

	return pages
		.filter((page) => getPageHref(page, pagesById) !== "/")
		.map((page) => {
			const href = getPageHref(page, pagesById);
			const slug = href.replace(/^\/|\/$/g, "");
			return {
				params: { slug },
				props: { page },
			};
		});
}

const { page } = Astro.props;
const useEmbeds = hasContentEmbeds(page.body);
const { Content } = await render(page);
const backgroundImage = resolveCmsImage(
	page.data.backgroundImage,
	`content/pages/${page.id}/`,
);
/** Hardwired system pages (same idea as Impressum attributions). */
const showBackgroundAttributions = page.id === "impressum";
const showArticleIndex = page.id === "artikel";
const wide = showArticleIndex || hasArticleListingEmbed(page.body);
---

<BaseLayout
	title={page.data.title}
	description={page.data.description}
	seo={page.data.seo}
	modifiedDate={page.data.modifiedDate}
	backgroundImage={backgroundImage}
	backgroundOverlay={page.data.backgroundOverlay}
>
	<main
		class:list={[
			"page",
			{ "page--with-sidebar": showArticleIndex, "page--wide": wide && !showArticleIndex },
		]}
	>
		{
			showArticleIndex ? (
				<div class="page-layout flex-row gap-lg stack-on-tablet">
					<div class="page-layout__main min-w-0 w-full">
						<article>
							<PageHero
								title={page.data.title}
								description={page.data.description}
							/>
							{useEmbeds ? <CmsContent body={page.body} /> : <Content />}
							<ArticleIndexList />
						</article>
					</div>
					<TagSidebar />
				</div>
			) : (
				<article>
					<PageHero
						title={page.data.title}
						description={page.data.description}
					/>
					{useEmbeds ? <CmsContent body={page.body} /> : <Content />}
					{showBackgroundAttributions && <BackgroundAttributions />}
				</article>
			)
		}
	</main>
</BaseLayout>
