---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import ArticleListing from "../../components/ArticleListing.astro";
import { getArticlesByTag } from "../../lib/articles";
import { buildTagBreadcrumbs } from "../../lib/breadcrumbs";
import { getGlossarForTag, getGlossarHref } from "../../lib/glossar";
import { formatTagHashtag } from "../../lib/tags";
import { contentWidthClass } from "../../cms/fields/content-width";
import {
	contentSpacingStyle,
	resolveContentSpacing,
} from "../../lib/content-spacing";
import { resolveContentWidth } from "../../lib/content-width";

export async function getStaticPaths() {
	const tags = await getCollection("tags");
	return tags.map((tag) => ({
		params: { slug: tag.id },
		props: { tag },
	}));
}

const { tag } = Astro.props;
const articles = await getArticlesByTag(tag.id, { sort: "newest" });
const hashtag = formatTagHashtag(tag);
const glossarEntry = await getGlossarForTag(tag.id);
const breadcrumbs = buildTagBreadcrumbs(hashtag);
const spacingStyle = contentSpacingStyle(resolveContentSpacing("tags"));
const widthClass = contentWidthClass(await resolveContentWidth("tags"));
---

<BaseLayout
	title={hashtag}
	description={tag.data.description}
	modifiedDate={tag.data.modifiedDate}
>
	<main class:list={["page", widthClass]} style={spacingStyle}>
		<PageHero
			title={hashtag}
			description={tag.data.description}
			breadcrumbs={breadcrumbs}
			collection="tags"
		/>
		{
			glossarEntry && (
				<p class="tag-glossar-link text-sm">
					Was ist {glossarEntry.data.title}?{" "}
					<a href={getGlossarHref(glossarEntry)}>Glossar</a>
				</p>
			)
		}
		{
			articles.length === 0 ? (
				<p>Keine veröffentlichten Artikel mit diesem Tag.</p>
			) : (
				<ArticleListing
					tagId={tag.id}
					count={0}
					sort="newest"
					layout="grid"
					columns={1}
					gap={3}
				/>
			)
		}
	</main>
</BaseLayout>
