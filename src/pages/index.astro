---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CmsContent from "../components/CmsContent.astro";
import PageHero from "../components/PageHero.astro";
import {
	contentNeedsWideLayout,
	hasContentEmbeds,
} from "../lib/content-embeds";
import { resolveCmsImage } from "../lib/cms-image";
import { isPagePublic } from "../lib/pages";

const page = await getEntry("pages", "index");
if (!page) {
	throw new Error('Missing pages collection entry "index".');
}
if (!isPagePublic(page)) {
	throw new Error('Start page "index" is not public (check status / publishDate).');
}
const useEmbeds = hasContentEmbeds(page.body);
const { Content } = await render(page);
const backgroundImage = resolveCmsImage(
	page.data.backgroundImage,
	`content/pages/${page.id}/`,
);
const wide = await contentNeedsWideLayout(page.body);
---

<BaseLayout
	title={page.data.title}
	description={page.data.description}
	seo={page.data.seo}
	modifiedDate={page.data.modifiedDate}
	backgroundImage={backgroundImage}
	backgroundOverlay={page.data.backgroundOverlay}
	headCode={page.data.headCode}
	footerCode={page.data.footerCode}
>
	<main class:list={["page", { "page--wide": wide }]}>
		<article>
			<PageHero title={page.data.title} description={page.data.description} />
			{useEmbeds ? <CmsContent body={page.body} /> : <Content />}
		</article>
	</main>
</BaseLayout>
