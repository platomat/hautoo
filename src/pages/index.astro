---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CmsContent from "../components/CmsContent.astro";
import { hasArticleListingEmbed, hasContentEmbeds } from "../lib/content-embeds";
import { resolveCmsImage } from "../lib/cms-image";

const page = await getEntry("pages", "index");
if (!page) {
	throw new Error('Missing pages collection entry "index".');
}
const useEmbeds = hasContentEmbeds(page.body);
const { Content } = await render(page);
const backgroundImage = resolveCmsImage(
	page.data.backgroundImage,
	`content/pages/${page.id}/`,
);
const wide = hasArticleListingEmbed(page.body);
---

<BaseLayout
	title={page.data.title}
	description={page.data.description}
	seo={page.data.seo}
	backgroundImage={backgroundImage}
	backgroundOverlay={page.data.backgroundOverlay}
>
	<main class:list={["page", { "page--wide": wide }]}>
		<article>
			<h1>{page.data.title}</h1>
			{useEmbeds ? <CmsContent body={page.body} /> : <Content />}
		</article>
	</main>
</BaseLayout>
