---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getArticleHref, getPublishedArticles } from "../../lib/articles";

const articles = await getPublishedArticles();
---

<BaseLayout
	title="Artikel"
	description="Beiträge und How-tos von hautuu."
>
	<main class="page">
		<h1>Artikel</h1>
		{
			articles.length === 0 ? (
				<p>Noch keine veröffentlichten Artikel.</p>
			) : (
				<ul class="article-list list-plain">
					{articles.map((article) => (
						<li>
							<a href={getArticleHref(article)}>{article.data.title}</a>
							{article.data.summary && (
								<p class="text-sm text-muted">{article.data.summary}</p>
							)}
							<p class="text-sm text-muted">
								<time datetime={article.data.pubDate.toISOString()}>
									{article.data.pubDate.toLocaleDateString("de-DE", {
										year: "numeric",
										month: "long",
										day: "numeric",
									})}
								</time>
							</p>
						</li>
					))}
				</ul>
			)
		}
	</main>
</BaseLayout>

<style>
	.article-list {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		margin: 0;
		padding: 0;
	}

	.article-list li > a {
		font-weight: var(--font-weight-heading);
		font-size: 1.125rem;
	}

	.article-list p {
		margin: 0.35rem 0 0;
	}
</style>
