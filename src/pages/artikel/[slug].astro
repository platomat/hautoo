---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import VideoEmbed from "../../components/VideoEmbed.astro";
import { getArticleHref } from "../../lib/articles";

export async function getStaticPaths() {
	const articles = await getCollection("articles");
	return articles
		.filter((article) => !article.data.draft)
		.map((article) => ({
			params: { slug: article.id },
			props: { article },
		}));
}

const { article } = Astro.props;
const { Content } = await render(article);
const tags = await getCollection("tags");
const tagMap = new Map(tags.map((tag) => [tag.id, tag]));
const linkedTags = (article.data.tags ?? [])
	.map((id) => tagMap.get(id))
	.filter((tag): tag is (typeof tags)[number] => Boolean(tag));
---

<BaseLayout
	title={article.data.title}
	description={article.data.summary}
	seo={article.data.seo}
>
	<main class="page">
		<article>
			<p class="text-sm text-muted">
				<a href="/artikel/">Artikel</a>
				{" · "}
				<time datetime={article.data.pubDate.toISOString()}>
					{article.data.pubDate.toLocaleDateString("de-DE", {
						year: "numeric",
						month: "long",
						day: "numeric",
					})}
				</time>
			</p>
			<h1>{article.data.title}</h1>
			{
				article.data.summary && (
					<p class="article-summary text-muted">{article.data.summary}</p>
				)
			}
			{
				linkedTags.length > 0 && (
					<ul class="article-tags list-plain flex-row flex-wrap gap-md text-sm">
						{linkedTags.map((tag) => (
							<li>
								<a href={`/tags/${tag.id}/`}>{tag.data.title}</a>
							</li>
						))}
					</ul>
				)
			}
			{
				article.data.heroImage && (
					<p>
						<Image
							src={article.data.heroImage}
							alt={article.data.title}
							widths={[640, 960]}
							sizes="(max-width: 679px) 100vw, 42rem"
						/>
					</p>
				)
			}
			<VideoEmbed
				provider={article.data.videoProvider}
				id={article.data.videoId}
				title={`Video: ${article.data.title}`}
			/>
			<Content />
		</article>
		<p class="text-sm">
			<a href="/artikel/">← Alle Artikel</a>
			{" · "}
			<a href={getArticleHref(article)} aria-current="page">Permalink</a>
		</p>
	</main>
</BaseLayout>

<style>
	.article-summary {
		font-size: 1.05rem;
		margin-top: 0;
	}

	.article-tags {
		margin: 0 0 1.25rem;
		padding: 0;
	}
</style>
