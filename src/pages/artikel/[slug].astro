---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import ArticleNav from "../../components/ArticleNav.astro";
import CmsContent from "../../components/CmsContent.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import VideoEmbed from "../../components/VideoEmbed.astro";
import {
	formatArticleDate,
	getAdjacentArticles,
	getArticleHref,
	getPublishedArticles,
} from "../../lib/articles";
import { resolveCmsImage } from "../../lib/cms-image";
import { contentWidthClass } from "../../cms/fields/content-width";
import { hasContentEmbeds } from "../../lib/content-embeds";
import { resolveContentWidth } from "../../lib/content-width";
import {
	estimateReadingTimeMinutes,
	formatReadingTime,
} from "../../lib/reading-time";
import { resolveTocForCollection } from "../../lib/site-config";
import { formatTagHashtag, getTagHref } from "../../lib/tags";

export async function getStaticPaths() {
	const articles = await getPublishedArticles();
	return articles.map((article) => ({
		params: { slug: article.id },
		props: { article },
	}));
}

const { article } = Astro.props;
const useEmbeds = hasContentEmbeds(article.body);
const { Content } = await render(article);
const contentWidth = await resolveContentWidth(
	"articles",
	article.data,
	article.body,
);
const widthClass = contentWidthClass(contentWidth);
const { older, newer } = await getAdjacentArticles(article);
const tags = await getCollection("tags");
const tagMap = new Map(tags.map((tag) => [tag.id, tag]));
const linkedTags = (article.data.tags ?? [])
	.map((id) => tagMap.get(id))
	.filter((tag): tag is (typeof tags)[number] => Boolean(tag));
const backgroundImage = resolveCmsImage(
	article.data.backgroundImage,
	`content/articles/${article.id}/`,
);
const toc = await resolveTocForCollection("articles", article.data);
/** Dynamic import: avoid shipping TOC CSS on pages that do not show a TOC. */
const TableOfContents = toc.show
	? (await import("../../components/TableOfContents.astro")).default
	: null;
const readingTimeMinutes = estimateReadingTimeMinutes(article.body);
const readingTimeLabel = formatReadingTime(readingTimeMinutes);
---

<BaseLayout
	title={article.data.title}
	description={article.data.summary}
	seo={article.data.seo}
	ogType="article"
	readingTimeMinutes={readingTimeMinutes}
	modifiedDate={article.data.modifiedDate}
	backgroundImage={backgroundImage}
	backgroundOverlay={article.data.backgroundOverlay}
>
	<main class:list={["page", widthClass]}>
		<article>
			<p class="text-sm text-muted">
				<a href="/artikel/">Artikel</a>
				{" · "}
				<time datetime={article.data.pubDate.toISOString()}>
					{formatArticleDate(article.data.pubDate)}
				</time>
				{" · "}
				<span>{readingTimeLabel}</span>
			</p>
			<PageHero title={article.data.title} description={article.data.summary} />
			{TableOfContents && (
				<TableOfContents
					body={article.body}
					levels={toc.levels}
					title={toc.title}
				/>
			)}
			{
				linkedTags.length > 0 && (
					<ul class="article-tags list-plain flex-row flex-wrap gap-md text-sm">
						{linkedTags.map((tag) => (
							<li>
								<a href={getTagHref(tag)}>{formatTagHashtag(tag)}</a>
							</li>
						))}
					</ul>
				)
			}
			{
				article.data.heroImage && (
					<p>
						<Image
							src={article.data.heroImage}
							alt={article.data.title}
							widths={[640, 960]}
							sizes="(max-width: 679px) 100vw, 42rem"
						/>
					</p>
				)
			}
			<VideoEmbed
				provider={article.data.videoProvider}
				id={article.data.videoId}
				title={`Video: ${article.data.title}`}
			/>
			{useEmbeds ? <CmsContent body={article.body} /> : <Content />}
			<ArticleNav older={older} newer={newer} />
		</article>
		<p class="text-sm">
			<a href="/artikel/">← Alle Artikel</a>
			{" · "}
			<a href={getArticleHref(article)} aria-current="page">Permalink</a>
		</p>
	</main>
</BaseLayout>

<style>
	.article-tags {
		margin: 0 0 1.25rem;
		padding: 0;
	}
</style>
