---
import type { ImageMetadata } from "astro";
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PageBackground from "../components/PageBackground.astro";
import {
	buildRobotsContent,
	resolveSeo,
	type Seo,
} from "../cms/fields/seo";
import { getBuildId, withBuildId } from "../lib/build-id";

interface Props {
	title?: string;
	description?: string;
	seo?: Seo;
	backgroundImage?: ImageMetadata;
	backgroundOverlay?: number;
}

const {
	title = "hautuu",
	description,
	seo: seoProp,
	backgroundImage,
	backgroundOverlay,
} = Astro.props;
const seo = resolveSeo(seoProp);

const documentTitle = seo.seo_title?.trim() || title;
const pageTitle =
	documentTitle === "hautuu" ? documentTitle : `${documentTitle} · hautuu`;
const metaDescription =
	seo.seo_description?.trim() || description?.trim() || undefined;
const robots = buildRobotsContent(seo);
const buildId = getBuildId();
const hasPageBackground = Boolean(backgroundImage);
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={withBuildId("/favicon.svg")} />
		<link rel="icon" href={withBuildId("/favicon.ico")} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="build-id" content={buildId} />
		<meta name="robots" content={robots} />
		{metaDescription && <meta name="description" content={metaDescription} />}
		<title>{pageTitle}</title>
	</head>
	<body class:list={{ "has-page-bg": hasPageBackground }}>
		{
			hasPageBackground && (
				<PageBackground image={backgroundImage} overlay={backgroundOverlay} />
			)
		}
		<SiteHeader />
		<div class="site-main">
			<slot />
		</div>
		<SiteFooter />
	</body>
</html>
