---
import LogoMark from "./LogoMark.astro";
import SiteSearch from "./SiteSearch.astro";
import { getResolvedMenu, MENU_MAIN } from "../lib/menus";
import { getPublicPages } from "../lib/pages";

const pages = await getPublicPages();
const menuItems = await getResolvedMenu(MENU_MAIN, pages);
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

function isCurrent(href: string): boolean {
	const key = href.replace(/\/$/, "") || "/";
	return pathname === key;
}
---

<header class="site-header" data-site-header>
	<div class="site-header__inner shell-inner">
		<a class="site-header__brand" href="/" aria-label="hautuu Startseite">
			<LogoMark class="site-header__logo-mark" />
			<span class="site-header__logo-text">hautuu</span>
		</a>
		<nav id="site-nav" class="site-nav" data-site-nav aria-label="Hauptnavigation">
			<ul class="site-nav__list list-plain">
				{
					menuItems.map((item, index) => {
						const current = !item.external && isCurrent(item.href);
						const hasChildren = item.children.length > 0;
						const subId = `site-nav-sub-${index}`;
						return (
							<li
								class:list={{
									"site-nav__item": true,
									"has-children": hasChildren,
								}}
								data-nav-item={hasChildren ? "" : undefined}
							>
								<div class="site-nav__item-row">
									<a
										href={item.href}
										class:list={item.cssClasses}
										aria-current={current ? "page" : undefined}
										target={item.external ? "_blank" : undefined}
										rel={item.external ? "noopener noreferrer" : undefined}
									>
										{item.label}
									</a>
									{hasChildren && (
										<button
											type="button"
											class="site-nav__sub-toggle"
											data-nav-sub-toggle
											aria-expanded="false"
											aria-controls={subId}
											aria-label={`Untermenü ${item.label}`}
										>
											<span class="site-nav__chevron" aria-hidden="true" />
										</button>
									)}
								</div>
								{hasChildren && (
									<ul
										id={subId}
										class="site-nav__sub list-plain"
										data-nav-sub
									>
										{item.children.map((child) => {
											const childCurrent =
												!child.external && isCurrent(child.href);
											return (
												<li>
													<a
														href={child.href}
														class:list={child.cssClasses}
														aria-current={childCurrent ? "page" : undefined}
														target={child.external ? "_blank" : undefined}
														rel={
															child.external ? "noopener noreferrer" : undefined
														}
													>
														{child.label}
													</a>
												</li>
											);
										})}
									</ul>
								)}
							</li>
						);
					})
				}
			</ul>
		</nav>
		<div class="site-header__actions">
			<SiteSearch />
			<button
				type="button"
				class="site-nav-toggle"
				data-nav-toggle
				aria-expanded="false"
				aria-controls="site-nav"
				aria-label="Menü öffnen"
			>
				<span class="site-nav-toggle__bars" aria-hidden="true">
					<span class="site-nav-toggle__bar"></span>
					<span class="site-nav-toggle__bar"></span>
					<span class="site-nav-toggle__bar"></span>
				</span>
			</button>
		</div>
	</div>
</header>

<script>
	import "../scripts/nav-toggle";
	import "../scripts/nav-submenu";
</script>

<style>
	.site-header {
		position: relative;
		z-index: 20;
		background: var(--color-chrome);
		border-bottom: 1px solid var(--color-border);
	}

	.site-header__inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.5rem;
		padding-block: 1rem;
	}

	.site-header__brand {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-weight: var(--font-weight-heading);
		font-size: 1.125rem;
		color: var(--color-text);
		line-height: 1;
	}

	.site-header__brand :global(.site-header__logo-mark) {
		display: block;
		width: 1.35rem;
		height: 1.35rem;
		flex-shrink: 0;
	}

	.site-header__brand:hover {
		color: var(--color-action-hover);
	}

	.site-header__actions {
		display: flex;
		align-items: center;
		gap: 0.15rem;
		flex-shrink: 0;
	}

	.site-nav-toggle {
		display: none;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		margin: 0;
		padding: 0;
		border: 0;
		border-radius: 0;
		background: transparent;
		color: var(--color-text);
		cursor: pointer;
	}

	.site-nav-toggle:hover {
		color: var(--color-action-hover);
	}

	.site-nav-toggle:focus-visible {
		color: var(--color-action-hover);
		outline: 2px solid var(--color-action);
		outline-offset: 2px;
	}

	.site-nav-toggle__bars {
		position: relative;
		display: block;
		width: 1.35rem;
		height: 1rem;
	}

	.site-nav-toggle__bar {
		position: absolute;
		left: 0;
		display: block;
		width: 100%;
		height: 2px;
		background: currentColor;
		transition:
			transform 0.22s ease,
			opacity 0.22s ease,
			top 0.22s ease;
	}

	.site-nav-toggle__bar:nth-child(1) {
		top: 0;
	}

	.site-nav-toggle__bar:nth-child(2) {
		top: calc(50% - 1px);
	}

	.site-nav-toggle__bar:nth-child(3) {
		top: calc(100% - 2px);
	}

	.site-header.is-nav-open .site-nav-toggle__bar:nth-child(1) {
		top: calc(50% - 1px);
		transform: rotate(45deg);
	}

	.site-header.is-nav-open .site-nav-toggle__bar:nth-child(2) {
		opacity: 0;
		transform: scaleX(0);
	}

	.site-header.is-nav-open .site-nav-toggle__bar:nth-child(3) {
		top: calc(50% - 1px);
		transform: rotate(-45deg);
	}

	.site-nav {
		margin-inline-start: auto;
	}

	.site-nav__list {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.25rem;
	}

	.site-nav__item-row {
		display: flex;
		align-items: center;
		gap: 0.2rem;
	}

	.site-nav__sub-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.75rem;
		height: 1.75rem;
		margin: 0;
		padding: 0;
		border: 0;
		border-radius: 0;
		background: transparent;
		color: var(--color-text-muted);
		cursor: pointer;
	}

	.site-nav__sub-toggle:hover,
	.site-nav__sub-toggle:focus-visible {
		color: var(--color-action);
	}

	.site-nav__sub-toggle:focus-visible {
		outline: 2px solid var(--color-action);
		outline-offset: 2px;
	}

	.site-nav__chevron {
		display: block;
		width: 0.45rem;
		height: 0.45rem;
		border-right: 1.5px solid currentColor;
		border-bottom: 1.5px solid currentColor;
		transform: rotate(45deg) translateY(-1px);
		transition: transform 0.2s ease;
	}

	.site-nav__item.is-sub-open .site-nav__chevron {
		transform: rotate(225deg) translateY(-1px);
	}

	.site-nav__sub {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-nav a[aria-current="page"] {
		color: var(--color-text);
	}

	/* Desktop: flyout dropdown */
	@media (min-width: 680px) {
		.site-nav-toggle {
			display: none;
		}

		.site-nav__item {
			position: relative;
		}

		/* Keep hover bridge to submenu (no gap that kills :hover). */
		.site-nav__item.has-children {
			padding-bottom: 0.45rem;
			margin-bottom: -0.45rem;
		}

		.site-nav__sub {
			position: absolute;
			top: 100%;
			/* Grow left from the item so right-edge menus don't widen the page */
			right: 0;
			left: auto;
			z-index: 40;
			min-width: 11rem;
			padding: 0.4rem 0;
			background: var(--color-chrome);
			border: 1px solid var(--color-border);
			visibility: hidden;
			opacity: 0;
			pointer-events: none;
			/* Do not use overflow:hidden — it clips the ::before hover bridge */
			transition:
				opacity 0.15s ease,
				visibility 0.15s;
		}

		/* Invisible hit area above the panel so the cursor can reach it. */
		.site-nav__sub::before {
			content: "";
			position: absolute;
			left: 0;
			right: 0;
			bottom: 100%;
			height: 0.5rem;
		}

		.site-nav__sub a {
			display: block;
			padding: 0.45rem 0.9rem;
			font-size: 0.95em;
			color: var(--color-text-muted);
			white-space: nowrap;
		}

		.site-nav__sub a:hover,
		.site-nav__sub a:focus-visible {
			color: var(--color-action);
			background: var(--color-action-muted);
		}

		.site-nav__item:hover .site-nav__sub,
		.site-nav__item:focus-within .site-nav__sub,
		.site-nav__item.is-sub-open .site-nav__sub {
			visibility: visible;
			opacity: 1;
			pointer-events: auto;
		}

		.site-nav__item:hover .site-nav__chevron,
		.site-nav__item:focus-within .site-nav__chevron,
		.site-nav__item.is-sub-open .site-nav__chevron {
			transform: rotate(225deg) translateY(-1px);
		}
	}

	/* Mobile: accordion under parent */
	@media (max-width: 679px) {
		.site-header {
			border-bottom: none;
		}

		.site-header__inner {
			flex-wrap: nowrap;
			border-bottom: 1px solid var(--color-border);
		}

		.site-header__actions {
			margin-inline-start: auto;
		}

		.site-nav-toggle {
			display: inline-flex;
			flex-shrink: 0;
		}

		.site-nav {
			position: absolute;
			top: 100%;
			/* Stretch to header edges — avoid 100vw (scrollbar overflow) */
			left: 0;
			right: 0;
			z-index: 30;
			width: auto;
			margin: 0;
			padding: 0.5rem var(--shell-padding-inline);
			background: var(--color-chrome);
			border-bottom: 1px solid var(--color-border);
			visibility: hidden;
			opacity: 0;
			pointer-events: none;
			transform: translateY(-0.35rem);
			transition:
				opacity 0.22s ease,
				transform 0.22s ease,
				visibility 0.22s;
		}

		.site-header.is-nav-open .site-nav {
			visibility: visible;
			opacity: 1;
			pointer-events: auto;
			transform: translateY(0);
		}

		.site-nav__list {
			flex-direction: column;
			flex-wrap: nowrap;
			align-items: stretch;
			gap: 0;
		}

		.site-nav__list > li + li {
			border-top: 1px solid var(--color-border);
		}

		.site-nav__item-row {
			justify-content: space-between;
		}

		.site-nav__item-row > a {
			flex: 1;
			padding: 0.75rem 0;
		}

		.site-nav__sub {
			display: none;
			padding: 0 0 0.5rem 0.75rem;
			border-top: 1px solid var(--color-border);
		}

		.site-nav__item.is-sub-open .site-nav__sub {
			display: block;
		}

		.site-nav__sub a {
			display: block;
			padding: 0.55rem 0;
			font-size: 0.95em;
			color: var(--color-text-muted);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-nav-toggle__bar,
		.site-nav,
		.site-nav__sub,
		.site-nav__chevron {
			transition: none;
		}
	}
</style>
