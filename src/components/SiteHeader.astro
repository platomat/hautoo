---
import { getCollection } from "astro:content";
import { getResolvedMenu, MENU_MAIN } from "../lib/menus";

const pages = await getCollection("pages");
const menuItems = await getResolvedMenu(MENU_MAIN, pages);
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

function isCurrent(href: string): boolean {
	const key = href.replace(/\/$/, "") || "/";
	return pathname === key;
}
---

<header class="site-header" data-site-header>
	<div class="site-header__inner shell-inner">
		<a class="site-header__brand" href="/">hautuu</a>
		<button
			type="button"
			class="site-nav-toggle"
			data-nav-toggle
			aria-expanded="false"
			aria-controls="site-nav"
			aria-label="Menü öffnen"
		>
			<span class="site-nav-toggle__bars" aria-hidden="true">
				<span class="site-nav-toggle__bar"></span>
				<span class="site-nav-toggle__bar"></span>
				<span class="site-nav-toggle__bar"></span>
			</span>
		</button>
		<nav id="site-nav" class="site-nav" data-site-nav aria-label="Hauptnavigation">
			<ul class="site-nav__list list-plain">
				{
					menuItems.map((item) => {
						const current = !item.external && isCurrent(item.href);
						return (
							<li class:list={{ "has-children": item.children.length > 0 }}>
								<a
									href={item.href}
									aria-current={current ? "page" : undefined}
									target={item.external ? "_blank" : undefined}
									rel={item.external ? "noopener noreferrer" : undefined}
								>
									{item.label}
								</a>
								{item.children.length > 0 && (
									<ul class="site-nav__sub list-plain">
										{item.children.map((child) => {
											const childCurrent =
												!child.external && isCurrent(child.href);
											return (
												<li>
													<a
														href={child.href}
														aria-current={childCurrent ? "page" : undefined}
														target={child.external ? "_blank" : undefined}
														rel={
															child.external ? "noopener noreferrer" : undefined
														}
													>
														{child.label}
													</a>
												</li>
											);
										})}
									</ul>
								)}
							</li>
						);
					})
				}
			</ul>
		</nav>
	</div>
</header>

<script>
	import "../scripts/nav-toggle";
</script>

<style>
	.site-header {
		position: relative;
		z-index: 20;
		background: var(--color-surface);
		border-bottom: 1px solid var(--color-border);
	}

	.site-header__inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.5rem;
		padding-block: 1rem;
	}

	.site-header__brand {
		font-weight: var(--font-weight-heading);
		font-size: 1.125rem;
		color: var(--color-text);
	}

	.site-header__brand:hover {
		color: var(--color-action-hover);
	}

	.site-nav-toggle {
		display: none;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		margin: 0;
		padding: 0;
		border: 0;
		border-radius: 0;
		background: transparent;
		color: var(--color-text);
		cursor: pointer;
	}

	.site-nav-toggle:focus-visible {
		outline: 2px solid var(--color-action);
		outline-offset: 2px;
	}

	.site-nav-toggle__bars {
		position: relative;
		display: block;
		width: 1.35rem;
		height: 1rem;
	}

	.site-nav-toggle__bar {
		position: absolute;
		left: 0;
		display: block;
		width: 100%;
		height: 2px;
		background: currentColor;
		transition:
			transform 0.22s ease,
			opacity 0.22s ease,
			top 0.22s ease;
	}

	.site-nav-toggle__bar:nth-child(1) {
		top: 0;
	}

	.site-nav-toggle__bar:nth-child(2) {
		top: calc(50% - 1px);
	}

	.site-nav-toggle__bar:nth-child(3) {
		top: calc(100% - 2px);
	}

	.site-header.is-nav-open .site-nav-toggle__bar:nth-child(1) {
		top: calc(50% - 1px);
		transform: rotate(45deg);
	}

	.site-header.is-nav-open .site-nav-toggle__bar:nth-child(2) {
		opacity: 0;
		transform: scaleX(0);
	}

	.site-header.is-nav-open .site-nav-toggle__bar:nth-child(3) {
		top: calc(50% - 1px);
		transform: rotate(-45deg);
	}

	.site-nav {
		margin-inline-start: auto;
	}

	.site-nav__list {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		gap: 0.75rem 1.25rem;
	}

	.site-nav__sub {
		margin: 0.35rem 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.site-nav a[aria-current="page"] {
		color: var(--color-text);
	}

	@media (max-width: 679px) {
		.site-header {
			border-bottom: none;
		}

		.site-header__inner {
			flex-wrap: nowrap;
			border-bottom: 1px solid var(--color-border);
		}

		.site-nav-toggle {
			display: inline-flex;
			margin-inline-start: auto;
			flex-shrink: 0;
		}

		.site-nav {
			position: absolute;
			top: 100%;
			left: 50%;
			z-index: 30;
			width: 100vw;
			margin: 0;
			padding: 0.5rem var(--shell-padding-inline);
			background: var(--color-surface);
			border-bottom: 1px solid var(--color-border);
			visibility: hidden;
			opacity: 0;
			pointer-events: none;
			transform: translate(-50%, -0.35rem);
			transition:
				opacity 0.22s ease,
				transform 0.22s ease,
				visibility 0.22s;
		}

		.site-header.is-nav-open .site-nav {
			visibility: visible;
			opacity: 1;
			pointer-events: auto;
			transform: translate(-50%, 0);
		}

		.site-nav__list {
			flex-direction: column;
			flex-wrap: nowrap;
			gap: 0;
		}

		.site-nav__list > li + li {
			border-top: 1px solid var(--color-border);
		}

		.site-nav__list > li > a {
			display: block;
			padding: 0.75rem 0;
		}

		.site-nav__sub {
			margin: 0 0 0.5rem;
			padding-inline-start: 0.75rem;
			gap: 0;
		}

		.site-nav__sub a {
			display: block;
			padding: 0.5rem 0;
			font-size: 0.95em;
			color: var(--color-text-muted);
		}
	}

	@media (min-width: 680px) {
		.site-nav-toggle {
			display: none;
		}

		.site-nav__sub {
			font-size: 0.9em;
		}

		.site-nav__sub a {
			color: var(--color-text-muted);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-nav-toggle__bar,
		.site-nav {
			transition: none;
		}
	}
</style>
