---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import {
	articleCountsByAuthor,
	getAuthorHref,
	resolveAuthorAvatar,
} from "../lib/authors";

const authors = (await getCollection("authors")).sort((a, b) =>
	a.data.title.localeCompare(b.data.title, "de", { sensitivity: "base" }),
);
const counts = await articleCountsByAuthor();
---

{
	authors.length === 0 ? (
		<p>Noch keine Autoren.</p>
	) : (
		<section class="author-listing" aria-label="Autoren">
			<ul class="author-listing__list list-plain">
				{authors.map((author) => {
					const avatar = resolveAuthorAvatar(author);
					const n = counts.get(author.id) ?? 0;
					return (
						<li class="author-listing__item">
							<a class="author-listing__link" href={getAuthorHref(author)}>
								{avatar ? (
									<Image
										class="author-listing__avatar"
										src={avatar}
										alt=""
										width={64}
										height={64}
									/>
								) : (
									<span class="author-listing__avatar author-listing__avatar--empty" />
								)}
								<span class="author-listing__text">
									<span class="author-listing__name">{author.data.title}</span>
									{author.data.description && (
										<span class="author-listing__desc text-sm text-muted">
											{author.data.description}
										</span>
									)}
									<span class="author-listing__count text-sm text-muted">
										{n === 1 ? "1 Artikel" : `${n} Artikel`}
									</span>
								</span>
							</a>
						</li>
					);
				})}
			</ul>
		</section>
	)
}

<style>
	.author-listing__list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin: 1.5rem 0 0;
		padding: 0;
	}

	.author-listing__link {
		display: flex;
		align-items: center;
		gap: 1rem;
		color: inherit;
		text-decoration: none;
	}

	.author-listing__link:hover .author-listing__name,
	.author-listing__link:focus-visible .author-listing__name {
		color: var(--color-action);
	}

	.author-listing__avatar {
		flex-shrink: 0;
		width: 4rem;
		height: 4rem;
		object-fit: cover;
		border-radius: 50%;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
	}

	.author-listing__avatar--empty {
		display: block;
	}

	.author-listing__text {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		min-width: 0;
	}

	.author-listing__name {
		font-weight: var(--font-weight-heading, 500);
	}
</style>
