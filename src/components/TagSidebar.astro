---
import {
	formatTagHashtag,
	getTagHref,
	getUsedTagsSorted,
} from "../lib/tags";

const tags = await getUsedTagsSorted();
---

{
	tags.length > 0 && (
		<aside class="tag-sidebar" aria-labelledby="tag-sidebar-heading">
			<h2 id="tag-sidebar-heading" class="tag-sidebar__title text-sm">
				Tags
			</h2>
			<ul class="tag-sidebar__list list-plain">
				{tags.map((tag) => (
					<li>
						<a href={getTagHref(tag)}>{formatTagHashtag(tag)}</a>
					</li>
				))}
			</ul>
		</aside>
	)
}

<style>
	.tag-sidebar {
		flex: 0 0 11rem;
		min-width: 9rem;
	}

	.tag-sidebar__title {
		margin: 0 0 0.75rem;
		font-weight: var(--font-weight-heading);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--color-text-muted);
	}

	.tag-sidebar__list {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
	}

	@media (max-width: 1023px) {
		.tag-sidebar {
			flex-basis: auto;
			min-width: 0;
			padding-top: 1.5rem;
			border-top: 1px solid var(--color-border);
		}

		.tag-sidebar__list {
			flex-direction: row;
			flex-wrap: wrap;
			gap: 0.5rem 1rem;
		}
	}
</style>
