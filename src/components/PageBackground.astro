---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { overlayAlpha } from "../cms/fields/page-background";

interface Props {
	image?: ImageMetadata;
	overlay?: number;
}

const { image, overlay } = Astro.props;

let src: string | undefined;
if (image) {
	const optimized = await getImage({
		src: image,
		width: 1920,
		format: "webp",
	});
	src = optimized.src;
}

const alpha = overlayAlpha(overlay);
---

{
	src && (
		<div class="page-bg" aria-hidden="true">
			<img class="page-bg__image" src={src} alt="" decoding="async" />
			<div class="page-bg__overlay" style={`opacity: ${alpha}`} />
		</div>
	)
}

<style>
	.page-bg {
		position: fixed;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		overflow: hidden;
	}

	.page-bg__image {
		display: block;
		width: 100%;
		height: 100%;
		max-width: none;
		object-fit: cover;
		object-position: center;
	}

	.page-bg__overlay {
		position: absolute;
		inset: 0;
		background: #000;
	}
</style>
