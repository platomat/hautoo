---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { overlayAlpha } from "../cms/fields/page-background";

interface Props {
	image?: ImageMetadata;
	overlay?: number;
}

const { image, overlay } = Astro.props;

/** Viewport cover: match common phone / tablet / desktop widths (project breakpoints ~680 / 1024). */
const BG_WIDTHS = [640, 960, 1280, 1920];

let src: string | undefined;
let srcset: string | undefined;
if (image) {
	const optimized = await getImage({
		src: image,
		width: 1920,
		widths: BG_WIDTHS,
		sizes: "100vw",
		format: "webp",
	});
	src = optimized.src;
	srcset = optimized.srcSet.attribute || undefined;
}

const alpha = overlayAlpha(overlay);
---

{
	src && (
		<div class="page-bg" aria-hidden="true">
			<img
				class="page-bg__image"
				src={src}
				srcset={srcset}
				sizes="100vw"
				alt=""
				decoding="async"
				fetchpriority="high"
			/>
			<div class="page-bg__overlay" style={`opacity: ${alpha}`} />
		</div>
	)
}

<style>
	.page-bg {
		position: fixed;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		overflow: hidden;
	}

	.page-bg__image {
		display: block;
		width: 100%;
		height: 100%;
		max-width: none;
		object-fit: cover;
		object-position: center;
	}

	.page-bg__overlay {
		position: absolute;
		inset: 0;
		background: #000;
	}
</style>
