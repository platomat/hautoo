---
import {
	isFileVideoProvider,
	isThirdPartyVideoProvider,
	normalizeVideoId,
	resolveFileVideoSrc,
	videoEmbedSrc,
	type VideoProvider,
} from "../lib/video";
import { resolveCmsImage } from "../lib/cms-image";
import { getVideoBaseUrl } from "../lib/site-config";

interface Props {
	provider?: string;
	/** YouTube/Vimeo id or URL; for `file` also accepts full URL or object key. */
	id?: string;
	/** Alias for file URL/key (`{{video provider="file" src="…" }}`). */
	src?: string;
	title?: string;
	/** Optional local CMS image path (no third-party thumbnail before consent). */
	poster?: string;
}

const { provider, id, src: srcProp, title = "Video", poster } = Astro.props;

const validProvider =
	isThirdPartyVideoProvider(provider) || isFileVideoProvider(provider)
		? (provider as VideoProvider)
		: undefined;

const posterMeta = poster ? resolveCmsImage(poster) : undefined;

let mode: "third-party" | "file" | undefined;
let iframeSrc: string | undefined;
let fileSrc: string | undefined;

if (validProvider && isThirdPartyVideoProvider(validProvider)) {
	const normalizedId = normalizeVideoId(validProvider, id ?? srcProp ?? "");
	iframeSrc = normalizedId
		? videoEmbedSrc(validProvider, normalizedId)
		: undefined;
	if (iframeSrc) {
		mode = "third-party";
	}
} else if (validProvider === "file") {
	fileSrc = resolveFileVideoSrc(srcProp ?? id ?? "", getVideoBaseUrl());
	if (fileSrc) {
		mode = "file";
	}
}

const providerLabel =
	validProvider === "youtube"
		? "YouTube"
		: validProvider === "vimeo"
			? "Vimeo"
			: "";
---

{
	mode === "file" && fileSrc && (
		<div class="video-embed video-embed--file">
			<video
				class="video-embed__player"
				controls
				playsinline
				preload="metadata"
				title={title}
				poster={posterMeta?.src}
			>
				<source src={fileSrc} type="video/mp4" />
				<a href={fileSrc}>Video herunterladen / öffnen</a>
			</video>
		</div>
	)
}

{
	mode === "third-party" && iframeSrc && (
		<div
			class="video-embed"
			data-video-embed
			data-video-src={iframeSrc}
			data-video-title={title}
			data-video-provider={validProvider}
		>
			<div class="video-embed__facade" data-video-facade>
				{posterMeta && (
					<img
						class="video-embed__poster"
						src={posterMeta.src}
						alt=""
						width={posterMeta.width}
						height={posterMeta.height}
						loading="lazy"
						decoding="async"
					/>
				)}
				<div class="video-embed__panel flex-row flex-align-center stack-on-mobile">
					<p class="video-embed__notice text-sm min-w-0">
						Zum Abspielen wird der Player von <strong>{providerLabel}</strong>{" "}
						geladen. Dabei verbindet sich dein Browser mit deren Servern; es
						können Cookies und ähnliche Techniken gesetzt werden. Details:{" "}
						<a href="/datenschutz/#eingebettete-videos">Datenschutz</a>.
					</p>
					<button
						type="button"
						class="video-embed__load flex-shrink-0 ms-auto"
						data-video-load
					>
						Video von {providerLabel} laden
					</button>
				</div>
			</div>
		</div>
	)
}

{
	mode === "third-party" && (
		<script>
			import { initVideoEmbeds } from "../scripts/videoEmbed";
			initVideoEmbeds();
		</script>
	)
}

<style>
	.video-embed {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		margin: 1.5rem 0;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		overflow: hidden;
	}

	.video-embed iframe,
	.video-embed__player {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.video-embed__player {
		background: #000;
		object-fit: contain;
	}

	.video-embed__facade {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		background: var(--color-surface-raised);
	}

	.video-embed__poster {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.45;
	}

	.video-embed__panel {
		position: relative;
		z-index: 1;
		width: 100%;
		padding: 1rem 1.1rem;
		background: var(--color-surface-glass);
		border-top: 1px solid var(--color-border);
	}

	.video-embed__notice {
		margin: 0;
	}

	.video-embed__load {
		appearance: none;
		margin: 0;
		padding: 0.55rem 0.9rem;
		border: 1px solid var(--color-action);
		border-radius: 4px;
		background: var(--color-action-muted);
		color: var(--color-text);
		font: inherit;
		font-weight: var(--font-weight-heading);
		cursor: pointer;
	}

	.video-embed__load:hover,
	.video-embed__load:focus-visible {
		background: var(--color-action);
		color: var(--color-bg);
	}

	.video-embed__load:focus-visible {
		outline: 2px solid var(--color-action);
		outline-offset: 2px;
	}
</style>
