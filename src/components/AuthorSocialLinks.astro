---
import {
	authorSocialLinkLabel,
	type AuthorSocialLink,
} from "../cms/fields/author-social";
import { getAuthorById } from "../lib/authors";
import AuthorSocialIcon from "./AuthorSocialIcon.astro";

interface Props {
	/** Explicit links (profile page / resolved). */
	links?: AuthorSocialLink[];
	/** Author slug; used when `links` omitted. */
	authorId?: string;
	/** Fallback author when embed has no `author=` (current profile). */
	defaultAuthorId?: string;
	/** Tighter spacing when rendered inside PageHero. */
	inHero?: boolean;
}

const { links: linksProp, authorId, defaultAuthorId, inHero = false } =
	Astro.props;

let items: AuthorSocialLink[] = [];
if (linksProp) {
	items = linksProp;
} else {
	const id = (authorId || defaultAuthorId || "").trim();
	if (id) {
		const author = await getAuthorById(id);
		items = author?.data.socialLinks ?? [];
	}
}
items = items.filter((link) => link.url?.trim());
---

{
	items.length > 0 && (
		<nav
			class:list={["author-social", inHero && "author-social--hero"]}
			aria-label="Web und Social Media"
		>
			<ul class="author-social__list list-plain">
				{items.map((link) => (
					<li>
						<a
							class="author-social__link"
							href={link.url.trim()}
							target="_blank"
							rel="noopener noreferrer me"
						>
							<AuthorSocialIcon platform={link.platform} size="1.1em" />
							<span>{authorSocialLinkLabel(link)}</span>
						</a>
					</li>
				))}
			</ul>
		</nav>
	)
}

<style>
	.author-social {
		margin: 0 0 2rem;
	}

	.author-social--hero {
		margin: 0.85rem 0 0;
	}

	.author-social__list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem 1.25rem;
		margin: 0;
		padding: 0;
	}

	.author-social__link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		line-height: 1.2;
	}
</style>
