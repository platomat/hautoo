---
import {
	getCategoryEntries,
	getCategoryListingsByIds,
	getCategoryHref,
	type CategorySort,
} from "../lib/categories";

interface Props {
	count?: number;
	sort?: CategorySort;
	layout?: "cloud" | "list" | "grid";
	columns?: number;
	/** Gap between items, in rem. */
	gap?: number;
	/** When set, only these category slugs. */
	categoryIds?: string[];
	/** For `categoryIds` mode: hide categories with zero articles (default true). */
	usedOnly?: boolean;
	/** Tighter vertical margin. */
	compact?: boolean;
}

const {
	count = 0,
	sort = "title-asc",
	layout = "grid",
	columns = 3,
	gap = 1.25,
	categoryIds,
	usedOnly = true,
	compact = false,
} = Astro.props;

/** `count === 0` → all matching categories. */
const entries = categoryIds?.length
	? await getCategoryListingsByIds(categoryIds, { usedOnly })
	: await getCategoryEntries({
			sort,
			limit: count === 0 ? undefined : count,
			usedOnly: true,
		});
const col = Math.min(4, Math.max(1, columns));
const gapRem = Math.min(8, Math.max(0, gap));
const max = Math.max(1, ...entries.map((entry) => entry.count));
---

{
	entries.length === 0 ? (
		<p>Noch keine Kategorien.</p>
	) : layout === "cloud" ? (
		<section
			class:list={[
				"category-listing",
				"category-listing--cloud",
				compact && "category-listing--compact",
			]}
			style={`--category-listing-gap: ${gapRem}rem`}
			aria-label="Kategorien"
		>
			<ul class="category-listing__list list-plain">
				{entries.map(({ category, count: n }) => {
					const weight = 0.85 + (n / max) * 0.45;
					return (
						<li>
							<a
								href={getCategoryHref(category)}
								style={`font-size: ${weight.toFixed(2)}rem`}
							>
								{category.data.title}
							</a>
						</li>
					);
				})}
			</ul>
		</section>
	) : (
		<section
			class:list={[
				"category-listing",
				layout === "list"
					? "category-listing--list"
					: "category-listing--grid",
				compact && "category-listing--compact",
			]}
			style={`--category-listing-cols: ${col}; --category-listing-gap: ${gapRem}rem`}
			aria-label="Kategorien"
		>
			<ul class="category-listing__list list-plain">
				{entries.map(({ category, count: n }) => (
					<li class="category-listing__item">
						<a
							class="category-listing__link"
							href={getCategoryHref(category)}
						>
							<span class="category-listing__title">
								{category.data.title}
							</span>
							{category.data.description ? (
								<p class="category-listing__desc text-sm text-muted">
									{category.data.description}
								</p>
							) : null}
							<span class="category-listing__count text-sm text-muted">
								{n} Artikel
							</span>
						</a>
					</li>
				))}
			</ul>
		</section>
	)
}

<style>
	.category-listing {
		margin: 2rem 0;
	}

	.category-listing--compact {
		margin: 0;
	}

	.category-listing__list {
		margin: 0;
		padding: 0;
	}

	.category-listing--cloud .category-listing__list {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.65rem var(--category-listing-gap, 1.1rem);
	}

	.category-listing--grid .category-listing__list {
		display: grid;
		grid-template-columns: repeat(
			var(--category-listing-cols, 3),
			minmax(0, 1fr)
		);
		gap: var(--category-listing-gap, 1.25rem);
	}

	.category-listing--list .category-listing__list {
		display: flex;
		flex-direction: column;
		gap: var(--category-listing-gap, 1.25rem);
	}

	.category-listing--grid .category-listing__item,
	.category-listing--list .category-listing__item {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1.1rem 1.15rem;
		background: var(--color-surface-glass);
		border: 1px solid var(--color-border);
		border-radius: 6px;
		min-width: 0;
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
	}

	@media (prefers-reduced-motion: reduce) {
		.category-listing--grid .category-listing__item,
		.category-listing--list .category-listing__item {
			-webkit-backdrop-filter: none;
			backdrop-filter: none;
		}
	}

	.category-listing__link {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		color: inherit;
		text-decoration: none;
		flex: 1 1 auto;
	}

	.category-listing__link:hover .category-listing__title {
		color: var(--color-action);
	}

	.category-listing__title {
		font-size: 1.1rem;
		font-weight: var(--font-weight-heading);
		line-height: 1.3;
		color: var(--color-text);
	}

	.category-listing__desc {
		margin: 0;
	}

	.category-listing__count {
		margin-top: auto;
	}

	@media (max-width: 1023px) {
		.category-listing--grid .category-listing__list {
			grid-template-columns: repeat(
				min(2, var(--category-listing-cols, 3)),
				minmax(0, 1fr)
			);
		}
	}

	@media (max-width: 679px) {
		.category-listing--grid .category-listing__list {
			grid-template-columns: 1fr;
		}
	}
</style>
