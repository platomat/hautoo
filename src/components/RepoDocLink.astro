---
import type { RepoDocEmbedProps } from "../lib/repodoc";

interface Props extends RepoDocEmbedProps {}

const { title, description, href, path } = Astro.props;
---

<aside class="repodoc" aria-label="Vertiefung im Repository">
	<a
		class="repodoc__link"
		href={href}
		target="_blank"
		rel="noopener noreferrer"
	>
		<span class="repodoc__icon" aria-hidden="true">
			<svg
				xmlns="http://www.w3.org/2000/svg"
				width="22"
				height="22"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="1.75"
				stroke-linecap="round"
				stroke-linejoin="round"
				><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path
					d="M12 8h.01"></path></svg
			>
		</span>
		<span class="repodoc__body">
			<span class="repodoc__kicker">Vertiefung im Repo</span>
			<span class="repodoc__title">{title}</span>
			{
				description && (
					<span class="repodoc__desc text-sm text-muted">{description}</span>
				)
			}
			<span class="repodoc__path text-sm text-muted">{path}</span>
		</span>
	</a>
</aside>

<style>
	.repodoc {
		margin: 1.75rem 0;
	}

	.repodoc__link {
		display: flex;
		gap: 1rem;
		align-items: flex-start;
		padding: 1rem 1.15rem;
		border: 1px solid var(--color-border);
		border-radius: 6px;
		background: var(--color-surface-glass);
		color: inherit;
		text-decoration: none;
		transition:
			border-color 0.15s ease,
			background-color 0.15s ease;
	}

	@media (prefers-reduced-motion: reduce) {
		.repodoc__link {
			transition: none;
		}
	}

	.repodoc__link:hover {
		border-color: var(--color-action-muted);
		background: var(--color-surface-raised);
	}

	.repodoc__link:hover .repodoc__title {
		color: var(--color-action);
	}

	.repodoc__icon {
		flex: 0 0 auto;
		margin-top: 0.1rem;
		color: var(--color-action);
	}

	.repodoc__body {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 0;
	}

	.repodoc__kicker {
		font-size: 0.75rem;
		font-weight: var(--font-weight-heading);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--color-text-muted);
	}

	.repodoc__title {
		font-weight: var(--font-weight-heading);
		line-height: 1.35;
		color: var(--color-text);
	}

	.repodoc__path {
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono",
			"Courier New", monospace;
		font-size: 0.8rem;
		opacity: 0.85;
	}
</style>
