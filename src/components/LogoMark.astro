---
/**
 * Site logo: CMS path from General → Logos, else default `/assets/logo-mark.svg`.
 * SVGs are inlined so CSS can recolor (default mark: ink/accent classes).
 */
import { Image } from "astro:assets";
import {
	resolveLogo,
	type LogoSlot,
} from "../lib/site-logo";

interface Props {
	/** Which configured logo (sticky/footer fall back to header). */
	variant?: LogoSlot;
	class?: string;
}

const { variant = "header", class: className } = Astro.props;
const logo = resolveLogo(variant);
---

{
	logo.kind === "svg" ? (
		<span
			class:list={[
				"logo-mark",
				logo.isDefault ? "logo-mark--default" : "logo-mark--custom",
				className,
			]}
			aria-hidden="true"
			set:html={logo.html}
		/>
	) : (
		<span
			class:list={["logo-mark", "logo-mark--raster", className]}
			aria-hidden="true"
		>
			<Image
				src={logo.meta}
				alt=""
				width={logo.meta.width}
				height={logo.meta.height}
			/>
		</span>
	)
}

<style>
	.logo-mark :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.logo-mark--raster :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	/* Default leaf mark: ink = currentColor, accent = action */
	.logo-mark--default :global(.logo-mark__ink) {
		stroke: currentColor;
		fill: none;
	}

	.logo-mark--default :global(.logo-mark__ink.logo-mark__leaf),
	.logo-mark--default :global(circle.logo-mark__ink) {
		fill: currentColor;
		stroke: none;
	}

	.logo-mark--default :global(.logo-mark__accent) {
		stroke: var(--color-action);
		fill: none;
	}

	.logo-mark--default :global(circle.logo-mark__accent) {
		fill: var(--color-action);
		stroke: none;
	}

	/* Custom SVG: paint with currentColor (override hard-coded fills/strokes). */
	.logo-mark--custom :global(svg [fill]:not([fill="none"])) {
		fill: currentColor;
	}

	.logo-mark--custom :global(svg [stroke]:not([stroke="none"])) {
		stroke: currentColor;
	}
</style>
