---
/**
 * Header leaf mark: inlines `public/img/logo-mark.svg` so CSS can recolor
 * (ink = currentColor, accent = action; hover → all action via SiteHeader).
 */
import logoMarkSvg from "../../public/img/logo-mark.svg?raw";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;

/** Strip XML prolog / comments; keep inner SVG for set:html. */
const svgHtml = logoMarkSvg
	.replace(/<\?xml[^?]*\?>/gi, "")
	.replace(/<!--[\s\S]*?-->/g, "")
	.trim();
---

<span
	class:list={["logo-mark", className]}
	aria-hidden="true"
	set:html={svgHtml}
/>

<style>
	.logo-mark :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.logo-mark :global(.logo-mark__ink) {
		stroke: currentColor;
		fill: none;
	}

	.logo-mark :global(.logo-mark__ink.logo-mark__leaf),
	.logo-mark :global(circle.logo-mark__ink) {
		fill: currentColor;
		stroke: none;
	}

	.logo-mark :global(.logo-mark__accent) {
		stroke: var(--color-action);
		fill: none;
	}

	.logo-mark :global(circle.logo-mark__accent) {
		fill: var(--color-action);
		stroke: none;
	}
</style>
