---
import CategoriesTree from "./CategoriesTree.astro";
import { getUsedCategoryForest } from "../lib/categories";
import {
	formatTagHashtag,
	getTagHref,
	getUsedTagsSorted,
} from "../lib/tags";

const [{ forest, counts }, tags] = await Promise.all([
	getUsedCategoryForest(),
	getUsedTagsSorted(),
]);

const showCategories = forest.length > 0;
const showTags = tags.length > 0;
---

{
	(showCategories || showTags) && (
		<aside
			class="article-sidebar"
			aria-label={
				showCategories && showTags
					? "Kategorien und Tags"
					: showCategories
						? "Kategorien"
						: "Tags"
			}
		>
			{
				showCategories && (
					<section
						class="article-sidebar__section"
						aria-labelledby="article-sidebar-categories"
					>
						<h2
							id="article-sidebar-categories"
							class="article-sidebar__title text-sm"
						>
							Kategorien
						</h2>
						<CategoriesTree nodes={forest} counts={counts} />
					</section>
				)
			}
			{
				showTags && (
					<section
						class:list={[
							"article-sidebar__section",
							showCategories && "article-sidebar__section--divided",
						]}
						aria-labelledby="article-sidebar-tags"
					>
						<h2
							id="article-sidebar-tags"
							class="article-sidebar__title text-sm"
						>
							Tags
						</h2>
						<ul class="article-sidebar__tag-list list-plain">
							{tags.map((tag) => (
								<li>
									<a href={getTagHref(tag)}>{formatTagHashtag(tag)}</a>
								</li>
							))}
						</ul>
					</section>
				)
			}
		</aside>
	)
}

<style>
	.article-sidebar {
		flex: 0 0 11rem;
		min-width: 9rem;
		padding-inline-start: 1.5rem;
		border-inline-start: 1px solid var(--color-border);
	}

	.article-sidebar__section--divided {
		margin-top: 1.15rem;
		padding-top: 1.15rem;
		border-top: 1px solid var(--color-border);
	}

	.article-sidebar__title {
		margin: 0 0 0.75rem;
		font-weight: var(--font-weight-heading);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--color-text-muted);
	}

	.article-sidebar__tag-list {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
	}

	@media (max-width: 1023px) {
		.article-sidebar {
			flex-basis: auto;
			min-width: 0;
			padding-inline-start: 0;
			border-inline-start: none;
			margin-top: 1.5rem;
			padding-top: 2rem;
			border-top: 1px solid var(--color-border);
		}

		.article-sidebar__section--divided {
			margin-top: 1.25rem;
			padding-top: 1.25rem;
		}

		.article-sidebar__tag-list {
			flex-direction: row;
			flex-wrap: wrap;
			gap: 0.5rem 1rem;
		}
	}
</style>
