---
import { resolveCmsImage } from "../lib/cms-image";
import { getVideoAccessWorkerUrl } from "../lib/site-config";

interface Props {
	/** Object key in the private R2 bucket (not a public URL). */
	src: string;
	title?: string;
	poster?: string;
}

const { src, title = "Video", poster } = Astro.props;
const workerUrl = getVideoAccessWorkerUrl();
const key = src.trim().replace(/^\/+/, "");
const posterMeta = poster ? resolveCmsImage(poster) : undefined;
const configured = Boolean(workerUrl && key);
---

{
	configured ? (
		<div
			class="member-video video-embed"
			data-member-video
			data-worker-url={workerUrl}
			data-video-key={key}
			data-video-title={title}
		>
			<div class="member-video__gate" data-member-gate>
				{posterMeta && (
					<img
						class="member-video__poster"
						src={posterMeta.src}
						alt=""
						width={posterMeta.width}
						height={posterMeta.height}
						loading="lazy"
						decoding="async"
					/>
				)}
				<div class="member-video__panel">
					<p class="member-video__lead text-sm">
						Dieses Video ist mit Zugangscode geschützt. Nach der Freischaltung
						bleibst du in diesem Browser angemeldet (localStorage), bis der Zugang
						abläuft oder du ihn zurücksetzt.
					</p>
					<form class="member-video__form flex-row flex-align-center stack-on-mobile" data-member-form>
						<label class="member-video__label min-w-0">
							<span class="visually-hidden">Zugangscode</span>
							<input
								class="member-video__input"
								type="text"
								name="code"
								autocomplete="off"
								autocapitalize="characters"
								spellcheck="false"
								placeholder="Zugangscode"
								required
								minlength="6"
								data-member-code
							/>
						</label>
						<button type="submit" class="member-video__submit flex-shrink-0">
							Freischalten
						</button>
					</form>
					<p class="member-video__status text-sm" data-member-status hidden></p>
					<button type="button" class="member-video__reset text-sm" data-member-reset>
						Zugang zurücksetzen
					</button>
				</div>
			</div>
			<div class="member-video__player-wrap" data-member-player-wrap hidden>
				<video
					class="video-embed__player"
					controls
					playsinline
					preload="metadata"
					crossorigin="anonymous"
					title={title}
					poster={posterMeta?.src}
					data-member-player
				></video>
			</div>
		</div>
	) : (
		<p class="member-video__misconfig text-sm" role="status">
			Member-Video: Worker-URL oder Dateiname fehlt (CMS Content → Medien →
			Video-Access-Worker-URL).
		</p>
	)
}

{
	configured && (
		<script>
			import { initMemberVideos } from "../scripts/memberVideo";
			initMemberVideos();
		</script>
	)
}

<style>
	.member-video {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		margin: 1.5rem 0;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-video, 0px);
		overflow: hidden;
	}

	.member-video__gate {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		background: var(--color-surface-raised);
	}

	.member-video__poster {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.4;
	}

	.member-video__panel {
		position: relative;
		z-index: 1;
		width: 100%;
		padding: 1rem 1.1rem;
		background: var(--color-surface-glass);
		border-top: 1px solid var(--color-border);
		-webkit-backdrop-filter: blur(3px);
		backdrop-filter: blur(3px);
	}

	@media (prefers-reduced-transparency: reduce) {
		.member-video__panel {
			-webkit-backdrop-filter: none;
			backdrop-filter: none;
			background: var(--color-surface-raised);
		}
	}

	.member-video__lead {
		margin: 0 0 0.75rem;
	}

	.member-video__form {
		gap: 0.65rem;
		margin: 0;
	}

	.member-video__label {
		flex: 1 1 auto;
		display: block;
	}

	.member-video__input {
		width: 100%;
		box-sizing: border-box;
		padding: 0.55rem 0.75rem;
		border: 1px solid var(--color-border);
		border-radius: 4px;
		background: var(--color-bg);
		color: var(--color-text);
		font: inherit;
	}

	.member-video__input:focus-visible {
		outline: 2px solid var(--color-action);
		outline-offset: 2px;
	}

	.member-video__submit {
		appearance: none;
		margin: 0;
		padding: 0.55rem 0.9rem;
		border: 1px solid var(--color-action);
		border-radius: 4px;
		background: var(--color-action-muted);
		color: var(--color-text);
		font: inherit;
		font-weight: var(--font-weight-heading);
		cursor: pointer;
	}

	.member-video__submit:hover,
	.member-video__submit:focus-visible {
		background: var(--color-action);
		color: var(--color-bg);
	}

	.member-video__submit:focus-visible {
		outline: 2px solid var(--color-action);
		outline-offset: 2px;
	}

	.member-video__status {
		margin: 0.65rem 0 0;
	}

	.member-video__status[data-error="1"] {
		color: var(--color-danger, #b33);
	}

	.member-video__reset {
		appearance: none;
		margin: 0.5rem 0 0;
		padding: 0;
		border: 0;
		background: none;
		color: var(--color-action);
		font: inherit;
		font-size: 14px;
		text-decoration: none;
		cursor: pointer;
	}

	.member-video__reset:hover,
	.member-video__reset:focus-visible {
		color: var(--color-action-hover);
	}

	.member-video__reset:focus-visible {
		outline: 2px solid var(--color-action);
		outline-offset: 2px;
	}

	.member-video__player-wrap {
		position: absolute;
		inset: 0;
	}

	.member-video :global(.video-embed__player) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		max-width: none;
		border: 0;
		background: #000;
		object-fit: contain;
	}

	.member-video__misconfig {
		margin: 1.5rem 0;
		padding: 0.75rem 1rem;
		border: 1px dashed var(--color-border);
		background: var(--color-surface);
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
