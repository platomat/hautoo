---
import {
	DEFAULT_SPACER_HEIGHT,
	clampSpacerHeight,
} from "../lib/spacer";

interface Props {
	/** Vertical gap in px (default 32). */
	height?: number;
}

const { height = DEFAULT_SPACER_HEIGHT } = Astro.props;
const heightPx = clampSpacerHeight(height);
---

{/* Inline height + ZWSP: reliable layout even if CSS vars lag. */}
<div
	class="spacer"
	style={`height: ${heightPx}px; --spacer-height: ${heightPx}px`}
	aria-hidden="true"
>
	&#8203;
</div>
