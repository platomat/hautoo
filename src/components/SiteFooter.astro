---
import { getCollection } from "astro:content";
import { getResolvedMenu, MENU_FOOTER_LEGAL } from "../lib/menus";
import { withBuildId } from "../lib/build-id";

/** First calendar year of the project (copyright range start). */
const COPYRIGHT_START_YEAR = 2026;
const currentYear = new Date().getFullYear();
const copyrightYears =
	currentYear > COPYRIGHT_START_YEAR
		? `${COPYRIGHT_START_YEAR}-${currentYear}`
		: String(COPYRIGHT_START_YEAR);

const REPO_URL = "https://github.com/platomat/hautoo/";
const REPO_TITLE = "hautuu auf GitHub (platomat/hautoo)";

const pages = await getCollection("pages");
const legalItems = await getResolvedMenu(MENU_FOOTER_LEGAL, pages);
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

function isCurrent(href: string): boolean {
	const key = href.replace(/\/$/, "") || "/";
	return pathname === key;
}
---

<footer class="site-footer">
	{/* Further footer menus can render above the copyright row. */}
	<div class="site-footer__bar">
		<p class="site-footer__copy text-sm text-muted">
			<span>© {copyrightYears}</span>
			{" "}
			<span>hautoo ∙ One of <a href="https://platomat.com/">PlatoMat</a></span>
		</p>
		<a
			class="site-footer__github"
			href={REPO_URL}
			title={REPO_TITLE}
			aria-label={REPO_TITLE}
			target="_blank"
			rel="noopener noreferrer"
		>
			<img
				src={withBuildId("/icons/github.svg")}
				alt=""
				width="28"
				height="28"
				decoding="async"
			/>
		</a>
		{
			legalItems.length > 0 ? (
				<nav class="site-footer__legal" aria-label="Rechtliches">
					<ul class="flex-row flex-align-baseline gap-md list-plain text-sm">
						{legalItems.map((item) => {
							const current = !item.external && isCurrent(item.href);
							return (
								<li>
									<a
										href={item.href}
										class:list={item.cssClasses}
										aria-current={current ? "page" : undefined}
										target={item.external ? "_blank" : undefined}
										rel={item.external ? "noopener noreferrer" : undefined}
									>
										{item.label}
									</a>
								</li>
							);
						})}
					</ul>
				</nav>
			) : (
				<span class="site-footer__legal" aria-hidden="true" />
			)
		}
	</div>
</footer>

<style>
	.site-footer {
		margin-top: auto;
		background: var(--color-chrome);
		border-top: 1px solid var(--color-border);
	}
</style>
