---
import type {
	EntryHero,
	HeroCollectionKey,
} from "../cms/fields/site-config";
import Icon from "./Icon.astro";
import Separator from "./Separator.astro";
import type { BreadcrumbItem } from "../lib/breadcrumbs";
import { resolveHeroForEntry } from "../lib/site-config";

interface Props {
	title: string;
	description?: string;
	/** Trail for breadcrumbs; ignored when showBreadcrumbs resolves to false. */
	breadcrumbs?: BreadcrumbItem[];
	/** Which Design → Hero collection defaults to use (CMS rail order). */
	collection?: HeroCollectionKey;
	/** Entry `hero` overrides from frontmatter. */
	hero?: EntryHero;
}

const {
	title,
	description,
	breadcrumbs = [],
	collection = "pages",
	hero: heroProp,
} = Astro.props;

const hero = resolveHeroForEntry(heroProp, collection);

const lead = description?.trim();
const crumbs =
	hero.showBreadcrumbs && breadcrumbs.length > 1 ? breadcrumbs : [];
const showBorder = hero.borderBottom !== "none";
const borderMark =
	hero.borderBottom === "logo" || hero.borderBottom === "favicon"
		? hero.borderBottom
		: "none";
---

<header
	class:list={[
		"hero",
		"page-hero",
		`page-hero--align-${hero.textAlign}`,
		showBorder && "page-hero--border",
	]}
>
	{
		crumbs.length > 0 && (
			<nav
				class="breadcrumbs"
				aria-label="Brotkrumen"
				style={`--breadcrumb-sep: ${JSON.stringify(hero.breadcrumbSeparator)}`}
			>
				<ol class="breadcrumbs__list list-plain">
					{crumbs.map((crumb, index) => {
						const isLast = index === crumbs.length - 1;
						const showHomeIcon = crumb.icon === "home" && !isLast;
						return (
							<li class="breadcrumbs__item">
								{!isLast && crumb.href ? (
									<a
										href={crumb.href}
										class:list={[showHomeIcon && "breadcrumbs__home"]}
										aria-label={showHomeIcon ? crumb.label : undefined}
									>
										{showHomeIcon ? (
											<Icon name="home" class="breadcrumbs__home-icon" />
										) : (
											crumb.label
										)}
									</a>
								) : (
									<span aria-current={isLast ? "page" : undefined}>
										{crumb.label}
									</span>
								)}
							</li>
						);
					})}
				</ol>
			</nav>
		)
	}
	<slot name="beforeTitle" />
	<h1>{title}</h1>
	{lead && <p class="hero__lead page-hero__lead text-muted">{lead}</p>}
	<slot name="below" />
	{
		showBorder && (
			<Separator
				class="page-hero__separator"
				mark={borderMark}
				markAlign={hero.borderMarkAlign}
				markSize={hero.borderMarkSize}
			/>
		)
	}
</header>
