---
import {
	formatTagHashtag,
	getTagEntries,
	getTagListingsByIds,
	getTagHref,
	type TagSort,
} from "../lib/tags";

interface Props {
	count?: number;
	sort?: TagSort;
	layout?: "cloud" | "list" | "grid";
	columns?: number;
	/** Gap between items, in rem. */
	gap?: number;
	/** When set, only these tag slugs (e.g. glossar related tags). */
	tagIds?: string[];
	/** For `tagIds` mode: hide tags with zero articles (default true). */
	usedOnly?: boolean;
	/** Tighter vertical margin (e.g. glossar related block). */
	compact?: boolean;
}

const {
	count = 0,
	sort = "title-asc",
	layout = "cloud",
	columns = 3,
	gap = 1.25,
	tagIds,
	usedOnly = true,
	compact = false,
} = Astro.props;

/** `count === 0` → all matching tags. */
const entries = tagIds?.length
	? await getTagListingsByIds(tagIds, { usedOnly })
	: await getTagEntries({
			sort,
			limit: count === 0 ? undefined : count,
			usedOnly: true,
		});
const col = Math.min(4, Math.max(1, columns));
const gapRem = Math.min(8, Math.max(0, gap));
const max = Math.max(1, ...entries.map((entry) => entry.count));
---

{
	entries.length === 0 ? (
		<p>Noch keine Tags.</p>
	) : layout === "cloud" ? (
		<section
			class:list={["tag-listing", "tag-listing--cloud", compact && "tag-listing--compact"]}
			style={`--tag-listing-gap: ${gapRem}rem`}
			aria-label="Tags"
		>
			<ul class="tag-listing__list list-plain">
				{entries.map(({ tag, count: n }) => {
					const weight = 0.85 + (n / max) * 0.45;
					return (
						<li>
							<a
								href={getTagHref(tag)}
								style={`font-size: ${weight.toFixed(2)}rem`}
							>
								{formatTagHashtag(tag)}
							</a>
						</li>
					);
				})}
			</ul>
		</section>
	) : (
		<section
			class:list={[
				"tag-listing",
				layout === "list" ? "tag-listing--list" : "tag-listing--grid",
				compact && "tag-listing--compact",
			]}
			style={`--tag-listing-cols: ${col}; --tag-listing-gap: ${gapRem}rem`}
			aria-label="Tags"
		>
			<ul class="tag-listing__list list-plain">
				{entries.map(({ tag, count: n }) => (
					<li class="tag-listing__item">
						<a class="tag-listing__link" href={getTagHref(tag)}>
							<span class="tag-listing__title">{formatTagHashtag(tag)}</span>
							{tag.data.description ? (
								<p class="tag-listing__desc text-sm text-muted">
									{tag.data.description}
								</p>
							) : null}
							<span class="tag-listing__count text-sm text-muted">
								{n} Artikel
							</span>
						</a>
					</li>
				))}
			</ul>
		</section>
	)
}

<style>
	.tag-listing {
		margin: 2rem 0;
	}

	.tag-listing--compact {
		margin: 0;
	}

	.tag-listing__list {
		margin: 0;
		padding: 0;
	}

	.tag-listing--cloud .tag-listing__list {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.65rem var(--tag-listing-gap, 1.1rem);
	}

	.tag-listing--grid .tag-listing__list {
		display: grid;
		grid-template-columns: repeat(var(--tag-listing-cols, 3), minmax(0, 1fr));
		gap: var(--tag-listing-gap, 1.25rem);
	}

	.tag-listing--list .tag-listing__list {
		display: flex;
		flex-direction: column;
		gap: var(--tag-listing-gap, 1.25rem);
	}

	.tag-listing--grid .tag-listing__item,
	.tag-listing--list .tag-listing__item {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1.1rem 1.15rem;
		background: var(--color-surface-glass);
		border: 1px solid var(--color-border);
		border-radius: 6px;
		min-width: 0;
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
	}

	@media (prefers-reduced-motion: reduce) {
		.tag-listing--grid .tag-listing__item,
		.tag-listing--list .tag-listing__item {
			-webkit-backdrop-filter: none;
			backdrop-filter: none;
		}
	}

	.tag-listing__link {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		color: inherit;
		text-decoration: none;
		flex: 1 1 auto;
	}

	.tag-listing__link:hover .tag-listing__title {
		color: var(--color-action);
	}

	.tag-listing__title {
		font-size: 1.1rem;
		font-weight: var(--font-weight-heading);
		line-height: 1.3;
		color: var(--color-text);
	}

	.tag-listing__desc {
		margin: 0;
	}

	.tag-listing__count {
		margin-top: auto;
	}

	@media (max-width: 1023px) {
		.tag-listing--grid .tag-listing__list {
			grid-template-columns: repeat(
				min(2, var(--tag-listing-cols, 3)),
				minmax(0, 1fr)
			);
		}
	}

	@media (max-width: 679px) {
		.tag-listing--grid .tag-listing__list {
			grid-template-columns: 1fr;
		}
	}
</style>
