---
import ArticleListing from "./ArticleListing.astro";
import CategoryListing from "./CategoryListing.astro";
import CmsButton from "./CmsButton.astro";
import ContactEmail from "./ContactEmail.astro";
import GlossarListing from "./GlossarListing.astro";
import Separator from "./Separator.astro";
import Spacer from "./Spacer.astro";
import TagCloud from "./TagCloud.astro";
import TagListing from "./TagListing.astro";
import RepoDocLink from "./RepoDocLink.astro";
import VideoConsentReset from "./VideoConsentReset.astro";
import VideoEmbed from "./VideoEmbed.astro";
import { buildContentSegments } from "../lib/content-embeds";

interface Props {
	body: string | undefined;
}

const { body } = Astro.props;
const segments = await buildContentSegments(body);
---

{
	segments.map((segment) => {
		if (segment.type === "html") {
			return <div class="cms-md" set:html={segment.html} />;
		}
		if (segment.type === "article-listing") {
			return (
				<ArticleListing
					count={segment.props.count}
					sort={segment.props.sort}
					layout={segment.props.layout}
					columns={segment.props.columns}
					gap={segment.props.gap}
					show={segment.props.show}
				/>
			);
		}
		if (segment.type === "glossar-listing") {
			return (
				<GlossarListing
					count={segment.props.count}
					sort={segment.props.sort}
					layout={segment.props.layout}
					columns={segment.props.columns}
					gap={segment.props.gap}
				/>
			);
		}
		if (segment.type === "tag-listing") {
			return (
				<TagListing
					count={segment.props.count}
					sort={segment.props.sort}
					layout={segment.props.layout}
					columns={segment.props.columns}
					gap={segment.props.gap}
				/>
			);
		}
		if (segment.type === "category-listing") {
			return (
				<CategoryListing
					count={segment.props.count}
					sort={segment.props.sort}
					layout={segment.props.layout}
					columns={segment.props.columns}
					gap={segment.props.gap}
				/>
			);
		}
		if (segment.type === "tag-cloud") {
			return <TagCloud />;
		}
		if (segment.type === "contact-email") {
			return <ContactEmail />;
		}
		if (segment.type === "separator") {
			return (
				<Separator
					height={segment.props.height}
					width={segment.props.width}
					color={segment.props.color}
				/>
			);
		}
		if (segment.type === "spacer") {
			return <Spacer height={segment.props.height} />;
		}
		if (segment.type === "button") {
			return (
				<CmsButton
					label={segment.props.label}
					href={segment.props.href}
					target={segment.props.target}
					style={segment.props.style}
					color={segment.props.color}
					align={segment.props.align}
				/>
			);
		}
		if (segment.type === "repodoc") {
			return <RepoDocLink {...segment.props} />;
		}
		if (segment.type === "video") {
			return (
				<VideoEmbed
					provider={segment.props.provider}
					id={segment.props.id}
					src={segment.props.src}
					title={segment.props.title}
					poster={segment.props.poster}
				/>
			);
		}
		if (segment.type === "video-consent-reset") {
			return <VideoConsentReset />;
		}
		return null;
	})
}
