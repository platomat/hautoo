# Dependencies
node_modules/

# Build / Astro
dist/
.astro/

# Search indexes (generated by scripts/build-search-index.mjs)
public/search/*
!public/search/.gitkeep

# Redirects (generated by scripts/build-redirects.mjs)
public/_redirects
public/.htaccess
public/nginx-redirects.conf

# Gravatar downloads (scripts/sync-author-avatars.mjs)
src/assets/authors/gravatar/*
!src/assets/authors/gravatar/.gitkeep

# Environment and secrets — never commit real values
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
hautoo.code-workspace
docs/sessions/

# Logs and caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.cache/
__pycache__/
*.py[cod]
