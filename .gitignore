.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
hautoo.code-workspace
docs/sessions/

# Logs and caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.cache/
__pycache__/
*.py[cod]
