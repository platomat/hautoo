# Cloudflare Pages cache headers (copied into dist/ on build).
# Hashed Astro bundles and fonts: long-lived, immutable.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Versioned via ?v=buildId in HTML; still cache a day when param changes.
/favicon.svg
  Cache-Control: public, max-age=86400

/favicon.ico
  Cache-Control: public, max-age=86400

# HTML and everything else: revalidate so deploys show up quickly.
/
  Cache-Control: public, max-age=0, must-revalidate

/*
  Cache-Control: public, max-age=0, must-revalidate
