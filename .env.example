# Copy to .env for local secrets. Never commit real values.
# Cloudflare / CMS tokens belong in platform env vars or local .env only.

# Public contact address for Impressum / Datenschutz ({{contact-email}}).
# Used when CMS general.contactEmail is empty. Set the same variable in
# Cloudflare Pages → Settings → Environment variables (Production).
# Prefer ENV over CMS in public repos so the address stays out of Git.
CONTACT_EMAIL=
